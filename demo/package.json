{
  "name": "exochain-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test:wasm": "node packages/exochain-wasm/test.mjs",
    "test:services": "NODE_ENV=test node --test services/*/test/index.test.js",
    "test:services:coverage": "NODE_ENV=test node --experimental-test-coverage --test services/*/test/index.test.js",
    "test:all": "npm run test:wasm && npm run test:services",
    "build:wasm": "cd .. && wasm-pack build crates/exochain-wasm --target nodejs --release --out-dir demo/packages/exochain-wasm/wasm",
    "dev": "docker compose -f infra/docker-compose.yml up --build"
  }
}
